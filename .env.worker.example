BIOEVIDENCE_BASE_URL=http://127.0.0.1:3000
LIVE_QA_WORKER_SECRET=use-the-same-long-secret-configured-in-vercel
BIOEVIDENCE_WORKER_ID=local-worker

# Full Live mode requires a local Pyserini/Lucene biomedical index.
BIOEVIDENCE_BM25_INDEX=/absolute/path/to/your/pubmed_index

BIOEVIDENCE_RETRIEVAL_PATH=adaptive
BIOEVIDENCE_ONLINE_SOURCES=auto
BIOEVIDENCE_BM25_PER_QUERY=40
BIOEVIDENCE_MAX_RERANK_CANDIDATES=48
BIOEVIDENCE_MAX_EVIDENCE_COUNT=10
BIOEVIDENCE_FRESH_PER_SOURCE=6

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M

# Recommended for responsible NCBI E-utilities usage.
NCBI_EMAIL=you@example.com
# NCBI_API_KEY=optional
