NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
LIVE_QA_WORKER_SECRET=replace-with-a-long-random-worker-secret

BIOEVIDENCE_BASE_URL=http://localhost:3000
BIOEVIDENCE_WORKER_ID=local-worker

# Local BioEvidence pipeline
BIOEVIDENCE_BM25_INDEX=/absolute/path/to/pubmed_index
BIOEVIDENCE_RETRIEVAL_PATH=adaptive
BIOEVIDENCE_BM25_PER_QUERY=40
BIOEVIDENCE_MAX_RERANK_CANDIDATES=48
BIOEVIDENCE_MAX_EVIDENCE_COUNT=10
BIOEVIDENCE_ONLINE_SOURCES=auto
BIOEVIDENCE_FRESH_PER_SOURCE=6
NCBI_EMAIL=you@example.com
# NCBI_API_KEY=optional-key-for-higher-rate-limits

# Ollama uses llama.cpp internally on Apple Silicon.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
